; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Structura 3D — Entorno de Análisis Estructural"
config/description="Entorno interactivo de análisis estructural en 3D con geometría editable, mallas, cargas, restricciones y resolución numérica por el Método de Rigidez Directa (DSM/FEM)."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=940
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.06, 0.09, 0.14, 1)
